# Frontend configuration for CRM (Vite)

# Base URL of the Laravel backend API. Example:
# http://localhost:8000/api or https://api.example.com/api
VITE_API_BASE_URL=http://localhost:8000/api

# Uwierzytelnianie
# Włącz integrację z Keycloak (true/false). Gdy false – tryb DEV bez logowania (jak w calc).
VITE_AUTH_ENABLED=false
# Konfiguracja Keycloak (wymagana, gdy VITE_AUTH_ENABLED=true)
VITE_KEYCLOAK_URL=
VITE_KEYCLOAK_REALM=
VITE_KEYCLOAK_CLIENT_ID=
# Opcjonalne logi debug dla auth (true/false)
VITE_AUTH_DEBUG=false
